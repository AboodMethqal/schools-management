generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model School {
  id               String          @id @default(cuid())
  schoolName       String
  slug             String
  schoolEmail      String
  phone            String?
  address          String?
  plan             String          @default("basic")
  duration         String          @default("12")
  schoolCategory   String
  expectedStudents Int?
  registrationId   String
  facebookUrl      String?
  websiteUrl       String?
  language         String          @default("arabic")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  announcements    Announcement[]
  attendance       Attendance[]
  classes          Class[]
  exams            Exam[]
  fees             Fee[]
  payments         Payment[]
  feedbacks        Feedback[]
  results          Result[]
  studyMaterials   StudyMaterial[]
  subjects         Subject[]
  supportTickets   SupportTicket[]
  teacherNotices   TeacherNotice[]
  users            User[]          @relation("SchoolUsers")
  students         Student[]
  teachers         Teacher[]
  expenses         Expense[]
  subscriptions    Subscription[]
  applications     SchoolApplication[]
}

model Subscription {
  id            String    @id @default(cuid())
  transactionId String    @unique
  amount        Float
  currency      String    @default("YER")
  status        String    @default("PENDING") // PENDING, SUCCESS, FAIL, CANCEL
  planName      String
  duration      String
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  method        String?
  valId         String?
  customerName  String
  customerEmail String
  customerPhone String?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([schoolId])
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  content       String
  audience      String    @default("all")
  targetClass   String?
  category      String    @default("academic")
  priority      String    @default("normal")
  attachmentUrl String?
  publishDate   DateTime  @default(now())
  expiryDate    DateTime?
  status        String    @default("published")
  schoolId      String
  authorId      String?
  authorName    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        User?     @relation("AuthorAnnouncements", fields: [authorId], references: [id])
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Student {
  id               String       @id @default(uuid())
  registrationNo   String
  firstName        String       @default("")
  lastName         String       @default("")
  dateOfBirth      DateTime
  gender           String
  bloodGroup       String?
  religion         String?
  currentClass     String?
  sectionName      String?
  sectionId        String?
  rollNo           Int
  session          String
  admissionDate    DateTime     @default(now())
  fatherName       String
  motherName       String
  guardianPhone    String
  emergencyContact String?
  email            String?
  presentAddress   String
  permanentAddress String?
  isActive         Boolean      @default(true)
  schoolId         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userId           String       @unique
  attendance       Attendance[]
  parents          Parent[]          @relation("LegacyStudentParent")
  parentLinks      ParentStudent[]
  feedbacks        Feedback[]
  payments         Payment[]
  results          Result[]
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section          Section?     @relation(fields: [sectionId], references: [id])
  user             User         @relation("UserStudent", fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model Plan {
  id        String   @id @default(cuid())
  name      String
  price     String
  duration  String
  icon      String?
  color     String?
  students  String
  teachers  String
  storage   String
  modules   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id            String   @id @default(cuid())
  subject       String
  description   String
  priority      String   @default("low")
  status        String   @default("open")
  schoolId      String?
  userEmail     String
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Teacher {
  id               String           @id @default(uuid())
  teacherId        String           @unique
  phone            String?
  dateOfBirth      DateTime
  gender           String
  bloodGroup       String?
  religion         String?
  designation      String
  department       String
  qualification    String
  joiningDate      DateTime         @default(now())
  salary           Float?
  presentAddress   String
  permanentAddress String?
  isActive         Boolean          @default(true)
  schoolId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  userId           String           @unique
  assignedClasses  String           @default("")
  attendances      Attendance[]
  schedules        ClassSchedule[]
  feedbacks        Feedback[]
  results          Result[]
  studyMaterials   StudyMaterial[]
  subjects         TeacherSubject[]
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User             @relation("UserTeacher", fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

model User {
  id             String          @id @default(uuid())
  authUserId     String          @unique
  schoolId       String?
  role           String          @default("student")
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  email          String          @unique
  name           String
  profileImage   String?
  password       String?
  mustChangePassword Boolean     @default(false)
  notifications  Notification[]  @relation("UserNotifications")
  announcements  Announcement[]  @relation("AuthorAnnouncements")
  teacherNotices TeacherNotice[] @relation("AuthorTeacherNotices")
  school         School?         @relation("SchoolUsers", fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student?        @relation("UserStudent")
  teacher        Teacher?        @relation("UserTeacher")
  parent         Parent?         @relation("UserParent")

  @@map("User")
}

model StudyMaterial {
  id            String   @id @default(cuid())
  title         String
  type          String
  subject       String
  class         String
  description   String?
  attachmentUrl String
  size          String?
  schoolId      String
  teacherId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model TeacherNotice {
  id          String   @id @default(cuid())
  title       String
  content     String
  audience    String   @default("students")
  targetClass String?
  category    String   @default("academic")
  priority    String   @default("normal")
  status      String   @default("published")
  schoolId    String
  authorId    String?
  authorName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User?    @relation("AuthorTeacherNotices", fields: [authorId], references: [id])
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Class {
  id         String          @id @default(cuid())
  name       String
  schoolId   String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  attendance Attendance[]
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schedules  ClassSchedule[]
  exams      Exam[]
  fees       Fee[]
  results    Result[]
  sections   Section[]
  subjects   Subject[]

  @@index([schoolId])
}

model Section {
  id        String    @id @default(cuid())
  name      String
  classId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  students  Student[]

  @@index([classId])
}

model Attendance {
  id        String   @id @default(uuid())
  date      DateTime
  status    String   @default("PRESENT")
  studentId String
  schoolId  String
  teacherId String?
  classId   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  class     Class?           @relation(fields: [classId], references: [id])
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher?         @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([schoolId])
  @@index([date])
}

model Result {
  id         String   @id @default(uuid())
  examType   String?
  subject    String?
  marks      Float
  studentId  String
  schoolId   String
  teacherId  String?
  classId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  examId     String?
  subjectId  String?
  class      Class?   @relation(fields: [classId], references: [id])
  exam       Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([schoolId])
}

model Payment {
  id            String   @id @default(cuid())
  transactionId String   @unique
  amount        Float
  currency      String   @default("YER")
  status        String   @default("PENDING")
  studentId     String
  schoolId      String
  feeCategory   String
  method        String?
  valId         String?
  customerName  String
  customerEmail String
  customerPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  feeId         String?
  fee           Fee?     @relation(fields: [feeId], references: [id])
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
}

model SupportOption {
  id          String   @id @default(cuid())
  title       String
  description String
  iconName    String // Lucide আইকনের নাম (যেমন: 'MessageCircle', 'Mail')
  status      String // ডিজাইনের ব্যাজ (যেমন: 'Coming Soon', 'Active', '24/7', 'Urgent')
  accentColor String // ডিজাইনের কালার কী (যেমন: 'blue', 'purple', 'emerald', 'amber')
  actionLabel String   @default("Contact Now")
  link        String   @default("#")
  order       Int      @default(0) // কার্ডের সিরিয়াল কন্ট্রোল করার জন্য
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportFAQ {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model Subject {
  id        String           @id @default(cuid())
  name      String
  code      String?
  classId   String
  schoolId  String
  createdAt DateTime         @default(now())
  schedules ClassSchedule[]
  results   Result[]
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers  TeacherSubject[]
}

model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model Exam {
  id        String   @id @default(cuid())
  name      String
  examType  String
  classId   String
  schoolId  String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  results   Result[]
}

model Fee {
  id        String    @id @default(cuid())
  title     String
  amount    Float
  classId   String?
  schoolId  String
  createdAt DateTime  @default(now())
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments  Payment[]
}

model ClassSchedule {
  id        String  @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  day       String
  startTime String
  endTime   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Parent {
  id          String          @id @default(cuid())
  name        String
  phone       String?
  email       String?
  studentId   String?
  userId      String?         @unique
  createdAt   DateTime        @default(now())
  student     Student?        @relation("LegacyStudentParent", fields: [studentId], references: [id], onDelete: Cascade)
  children    ParentStudent[]
  user        User?           @relation("UserParent", fields: [userId], references: [id], onDelete: Cascade)
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Expense {
  id            String   @id @default(cuid())
  title         String
  category      String
  amount        Float
  transactionAt DateTime
  note          String?
  status        String   @default("Paid")
  attachmentUrl String?
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, transactionAt])
}

model Feedback {
  id            String   @id @default(cuid())
  academic      Int      @default(0)
  behavior      Int      @default(0)
  participation Int      @default(0)
  comment       String?
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([schoolId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("system") // academic, system, payment, alert
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean  @default(false)
  link      String? // Optional target URL (e.g., /dashboard/student/result)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model QuizRoom {
  id           String   @id @default(cuid())
  roomCode     String   @unique
  roomTitle    String
  teacherEmail String
  category     String?
  currentClass String?
  duration     String?
  exam         Boolean  @default(false)
  schoolId     String?
  questions    Json     @default("[]")
  payload      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teacherEmail])
  @@index([createdAt])
}

model QuizSubmission {
  id             String   @id @default(cuid())
  questionID     String
  studentName    String
  studentEmail   String
  schoolId       String?
  examSubject    String?
  teacherEmail   String?
  roomCode       String
  totalMark      Int
  totalQuestions Int
  studentAnswers Json?
  submittedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([roomCode, studentEmail])
  @@index([questionID])
  @@index([studentEmail])
  @@index([teacherEmail])
  @@index([schoolId])
  @@index([submittedAt])
}

// Global configuration for the system (used by super admin dashboard)
model SystemConfig {
  id           String   @id @default("system_config")
  siteName     String?
  siteSubtitle String?
  siteLogo     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SchoolApplication {
  id            String    @id @default(cuid())
  applicationNo String    @unique
  schoolName    String
  adminName     String
  email         String
  phone         String
  instituteCode String?
  passwordHash  String?
  message       String?
  status        String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewNotes   String?
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

